# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
packets_*.txt

node_modules
dist
dist-ssr
*.local

# Build artifacts
/src-tauri/target/
/src-tauri/gen/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local config
settings.properties

# Copied static files (generated from src/ at build/dev time)
/public/*
!/public/src/
/public/src/*
!/public/src/js/
# ...except vendored third-party libs, which are source, not generated. Without
# these a fresh clone builds an app whose icons 404.
!/public/vendor/
# Class icons (<Korean class name>.png, as core.js/meter.js/details.js/history.js
# request them). Upstream adds these at release time from outside git, so a
# clean tree shipped without them; this fork keeps them in the repo.
!/public/assets/
/assets/
/data/
/i18n/

# Debug binaries
/src-tauri/src/bin/
.claude/
